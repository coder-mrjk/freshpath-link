rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users/{uid}
    // Document ID: Firebase Auth UID
    // Fields:
    //   - uid: string (required) - Firebase Auth UID
    //   - role: string (required, 'farmer'|'driver'|'mandi'|'shop'|'consumer')
    //   - status: string (required, 'pending'|'approved'|'suspended'|'rejected')
    //   - firstName: string (required)
    //   - fullName: string (private)
    //   - phone: string (private)
    //   - addressText: string (private)
    //   - preferredLang: string ('en'|'ta')
    //   - passId: string (optional, issued by owner on approval)
    //   - createdAt: timestamp (creation time)
    //   - approvedAt: timestamp (optional, set only by owner)
    //   - approvedBy: string (optional, set only by owner)
    //
    // Collection: owners/{uid}
    // Document ID: Firebase Auth UID of authorized system owners
    // Fields:
    //   - uid: string (required)
    //   - role: string (optional, 'owner')
    //
    // Collection: counters/{role}
    // Document ID: Role name ('farmer'|'driver'|'mandi'|'shop'|'consumer')
    // Fields:
    //   - next: number (required) - Next sequential pass number
    //
    // Collection: devices/{uid}
    // Document ID: Device auth UID
    // Fields:
    //   - type: string ('gps'|'storage')
    //   - unitId: string (hardware unit identifier)
    //
    // Collection: products/{prodId}
    // Document ID: Product identifier (e.g. 'tomato')
    // Fields:
    //   - name: string (required)
    //   - ratePerKg: number (required)
    //   - active: bool (required)
    //   - updatedAt: timestamp (optional)
    //
    // Collection: config/{docId}
    // Document ID: Config key (e.g. 'freshness')
    // Fields:
    //   - perHourSinceHarvest: number
    //   - perHourStoredAbove30C: number
    //   - freshMin: number
    //   - sellSoonMin: number
    //
    // Collection: fields/{fieldId}
    // Document ID: Auto-generated or custom field ID
    // Fields:
    //   - farmerUid: string (required, creator UID)
    //   - name: string (required)
    //   - village: string (required)
    //   - district: string (optional)
    //   - lat: number (optional)
    //   - lng: number (optional)
    //   - createdAt: timestamp (optional)
    //
    // Collection: vehicles/{vehicleId}
    // Document ID: Uppercase registration number without spaces
    // Fields:
    //   - driverUid: string (required, creator UID)
    //   - regNumber: string (required)
    //   - vehicleType: string (required)
    //   - capacityKg: number (required)
    //   - gpsUnitId: string (optional, linked by owner)
    //   - status: string (e.g. 'PENDING_GPS'|'ACTIVE')
    //   - createdAt: timestamp (optional)
    //
    // Collection: gpsUnits/{gpsId}
    // Document ID: GPS unit ID (e.g. 'GPS-01')
    // Fields:
    //   - vehicleId: string (optional)
    //   - latest: map (lat, lng, speedKmph, sats, hdop, valid, fixAt)
    //   - receivedAt: timestamp (optional)
    //
    // Collection: trips/{tripId}
    // Document ID: Trip ID (e.g. 'TRP-YYMMDD-XXXX')
    // Fields:
    //   - driverUid: string (required, creator UID)
    //   - vehicleId: string (required)
    //   - gpsUnitId: string (required)
    //   - originText: string (required)
    //   - destinationMandiId: string (required)
    //   - status: string ('DRAFT'|'IN_TRANSIT'|'ENDED')
    //   - bagIds: list (optional)
    //   - start: map (optional)
    //   - end: map (optional)
    //   - startedAt: timestamp (optional)
    //   - endedAt: timestamp (optional)
    //   - distanceKmStraight: number (optional)
    //   - durationMin: number (optional)
    //
    // Collection: mandis/{mandiId}
    // Document ID: Mandi document ID
    // Fields:
    //   - mandiPersonUid: string (required)
    //   - name: string (required)
    //   - area: string (required)
    //   - lat: number (optional)
    //   - lng: number (optional)
    //
    // Subcollection: mandis/{mandiId}/readings/{readingId}
    // Document ID: Auto-generated reading ID
    // Fields:
    //   - tempC: number (required)
    //   - humidityPct: number (required)
    //   - at: timestamp (required)
    //
    // Collection: storageUnits/{unitId}
    // Document ID: Storage unit ID (e.g. 'STORE-01')
    // Fields:
    //   - mandiId: string (required)
    //   - name: string (required)
    //   - nodeUnitId: string (required)
    //   - latest: map (tempC, humidityPct, at)
    //
    // Subcollection: storageUnits/{unitId}/readings/{readingId}
    // Document ID: Auto-generated reading ID
    // Fields:
    //   - tempC: number (required)
    //   - humidityPct: number (required)
    //   - at: timestamp (required)
    //
    // Collection: shops/{shopId}
    // Document ID: Shop document ID
    // Fields:
    //   - shopPersonUid: string (required)
    //   - name: string (required)
    //   - area: string (required)
    //   - lat: number (optional)
    //   - lng: number (optional)
    //
    // Collection: bags/{bagId}
    // Document ID: Bag ID (e.g. 'FP-TOM-YYMMDD-XXXXXX')
    // Fields:
    //   - product: string ('tomato')
    //   - farmerUid: string (required)
    //   - farmerPassId: string (required)
    //   - farmerFirstName: string (required)
    //   - fieldId: string (required)
    //   - fieldName: string (required)
    //   - village: string (required)
    //   - weightKg: number (required)
    //   - pieces: number (required)
    //   - pricePerKg: number (required)
    //   - totalPrice: number (required)
    //   - status: string ('CREATED'|'PENDING_PICKUP'|'LOADED'|'IN_TRANSIT'|'IN_STORAGE'|'DISPATCHED_TO_SHOP'|'AT_SHOP'|'PAYMENT_PENDING'|'SOLD')
    //   - tripId: string (optional)
    //   - storageUnitId: string (optional)
    //   - mandiId: string (optional)
    //   - shopId: string (optional)
    //   - holderUid: string (optional)
    //   - handlerUids: list (optional)
    //   - createdAt: timestamp (optional)
    //   - updatedAt: timestamp (optional)
    //   - soldTo: map (optional)
    //   - rating: map (optional)
    //
    // Collection: events/{eventId}
    // Document ID: Event document ID
    // Fields:
    //   - bagId: string (required)
    //   - type: string (required)
    //   - byUid: string (required, creator UID)
    //   - byRole: string (required)
    //   - byPassId: string (required)
    //   - at: timestamp (required)
    //   - place: map (optional)
    //   - tripId: string (optional)
    //   - note: string (optional)
    //
    // Collection: purchases/{purchaseId}
    // Document ID: Purchase document ID
    // Fields:
    //   - bagId: string (required)
    //   - consumerUid: string (required)
    //   - consumerPassId: string (optional)
    //   - price: number (required)
    //   - at: timestamp (required)
    //   - paymentStatus: string ('NOT_ENABLED'|'PAID_COUNTER')
    //   - shopId: string (optional)
    //   - shopName: string (optional)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn() && (
        request.auth.uid == 'oMl0ziVO7aWj9MH26ocPGH41fG12' ||
        (request.auth.token.email != null && request.auth.token.email.lower() == 'tonightgamermrjk@gmail.com') ||
        exists(/databases/$(database)/documents/owners/$(request.auth.uid))
      );
    }

    function getUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isApproved(role) {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUser().status == 'approved' &&
        getUser().role == role;
    }

    function isDevice(unitId, type) {
      return signedIn() &&
        exists(/databases/$(database)/documents/devices/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/devices/$(request.auth.uid)).data.unitId == unitId &&
        get(/databases/$(database)/documents/devices/$(request.auth.uid)).data.type == type;
    }

    function isStorageNodeOf(mandi) {
      return signedIn() &&
        exists(/databases/$(database)/documents/devices/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/devices/$(request.auth.uid)).data.type == 'storage' &&
        ('nodeUnitId' in mandi) &&
        get(/databases/$(database)/documents/devices/$(request.auth.uid)).data.unitId == mandi.nodeUnitId;
    }

    // Helper for bag state transitions across the supply chain
    function isValidBagStatusTransition() {
      let prev = resource.data.status;
      let next = request.resource.data.status;
      return isOwner() ||
             // Driver pickup request
             ((isApproved('driver') || signedIn()) && prev == 'CREATED' && next == 'PENDING_PICKUP') ||
             // Farmer handover approval
             ((isApproved('farmer') || signedIn()) && prev == 'PENDING_PICKUP' && next == 'LOADED') ||
             // Farmer handover decline
             ((isApproved('farmer') || signedIn()) && prev == 'PENDING_PICKUP' && next == 'CREATED') ||
             // Trip transit (with backward compatible direct load/transit)
             ((isApproved('driver') || signedIn()) && prev == 'CREATED' && next == 'LOADED') ||
             ((isApproved('driver') || signedIn()) && (prev == 'LOADED' || prev == 'CREATED') && next == 'IN_TRANSIT') ||
             // Mandi check-in
             ((isApproved('mandi') || signedIn()) && (prev == 'IN_TRANSIT' || prev == 'LOADED') && next == 'IN_STORAGE') ||
             // Mandi dispatch
             ((isApproved('mandi') || signedIn()) && prev == 'IN_STORAGE' && next == 'DISPATCHED_TO_SHOP') ||
             // Shop receiving
             ((isApproved('shop') || signedIn()) && (prev == 'DISPATCHED_TO_SHOP' || prev == 'IN_STORAGE') && next == 'AT_SHOP') ||
             // Consumer counter payment request
             ((isApproved('consumer') || signedIn()) && prev == 'AT_SHOP' && next == 'PAYMENT_PENDING') ||
             // Shopkeeper payment received
             ((isApproved('shop') || signedIn()) && prev == 'PAYMENT_PENDING' && next == 'SOLD') ||
             // Direct purchase fallback
             ((isApproved('consumer') || signedIn()) && prev == 'AT_SHOP' && next == 'SOLD');
    }

    // Helper for consumer rating update on a sold bag
    function isValidBagRatingUpdate() {
      return resource.data.status == 'SOLD' &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'updatedAt']) &&
             signedIn();
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // Users collection: Strict PII boundary (phone, address, full name).
    // Self-registration allowed with initial pending status (or approved for consumer).
    // Privilege elevation fields (approvedBy, approvedAt) are strictly prohibited on user create.
    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isOwner());
      allow list: if isOwner();
      allow create: if signedIn() && (
        isOwner() || (
          request.auth.uid == uid &&
          request.resource.data.role in ['farmer', 'driver', 'mandi', 'shop', 'consumer', 'owner'] &&
          (request.resource.data.role in ['consumer', 'owner'] ? request.resource.data.status == 'approved' : request.resource.data.status == 'pending') &&
          !('approvedBy' in request.resource.data) &&
          !('approvedAt' in request.resource.data)
        )
      );
      allow update: if isOwner() || (
        signedIn() &&
        request.auth.uid == uid &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'email', 'role', 'status', 'passId', 'approvedAt', 'approvedBy', 'uid', 'createdAt'
        ])
      );
      allow delete: if isOwner();
    }

    // System owners: Root administrators
    match /owners/{uid} {
      allow read: if signedIn();
      allow write: if isOwner() || (signedIn() && (
        request.auth.uid == 'oMl0ziVO7aWj9MH26ocPGH41fG12' ||
        (request.auth.token.email != null && request.auth.token.email.lower() == 'tonightgamermrjk@gmail.com')
      ));
    }

    // Role-specific pass ID counters (atomic increments by owner or during signup/approval)
    match /counters/{role} {
      allow read, write: if isOwner() || signedIn();
    }

    // Device credentials & bindings
    match /devices/{deviceId} {
      allow read: if signedIn() && (request.auth.uid == deviceId || isOwner());
      allow write: if isOwner();
    }

    // Products catalog & pricing
    match /products/{prodId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // System configuration (e.g. freshness decay parameters)
    match /config/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Farm fields registered by farmers (both approved and newly registered) or owner
    match /fields/{fieldId} {
      allow read: if signedIn();
      allow create: if isOwner() || (signedIn() && request.resource.data.farmerUid == request.auth.uid);
      allow update: if isOwner() || (signedIn() && (request.resource.data.farmerUid == request.auth.uid || resource.data.farmerUid == request.auth.uid));
      allow delete: if isOwner() || (signedIn() && resource.data.farmerUid == request.auth.uid);
    }

    // Transport vehicles registered by drivers, hardware-linked by owner
    match /vehicles/{vehicleId} {
      allow read: if signedIn();
      allow create: if isOwner() || (signedIn() && request.resource.data.driverUid == request.auth.uid);
      allow update: if isOwner() || (signedIn() && resource.data.driverUid == request.auth.uid);
      allow delete: if isOwner() || (signedIn() && resource.data.driverUid == request.auth.uid);
    }

    // GPS hardware units telemetry
    match /gpsUnits/{gpsId} {
      allow read: if signedIn();
      allow create: if isOwner() || isDevice(gpsId, 'gps');
      allow update: if isOwner() || (
        isDevice(gpsId, 'gps') &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['latest', 'receivedAt']) &&
        request.resource.data.latest is map &&
        request.resource.data.latest.valid is bool &&
        request.resource.data.latest.sats is int &&
        request.resource.data.latest.hdop is number &&
        request.resource.data.latest.speedKmph is number
      );
      allow delete: if isOwner();
    }

    // Transit trips managed by drivers or owner
    // Signed-in parties (e.g. farmers approving handover) can append/update bagIds without modifying operational trip fields
    match /trips/{tripId} {
      allow read: if true;
      allow create: if isOwner() || ((isApproved('driver') || signedIn()) && request.resource.data.driverUid == request.auth.uid);
      allow update: if isOwner() ||
        ((isApproved('driver') || signedIn()) && resource.data.driverUid == request.auth.uid) ||
        (signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bagIds', 'updatedAt']));
      allow delete: if isOwner();
    }

    // Mandi warehouse locations
    match /mandis/{mandiId} {
      allow read: if true;
      allow create, update: if isOwner() || isApproved('mandi') || (signedIn() && (request.resource.data.mandiPersonUid == request.auth.uid || resource.data.mandiPersonUid == request.auth.uid));
      allow delete: if isOwner() || (signedIn() && resource.data.mandiPersonUid == request.auth.uid);
      allow update: if isStorageNodeOf(resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['currentTemp', 'currentHumidity', 'latest', 'updatedAt']);

      // Telemetry readings subcollection for Mandi
      match /readings/{readingId} {
        allow read: if true;
        allow create: if isOwner() || isApproved('mandi') || (
          signedIn() &&
          exists(/databases/$(database)/documents/mandis/$(mandiId)) &&
          isStorageNodeOf(get(/databases/$(database)/documents/mandis/$(mandiId)).data) &&
          request.resource.data.keys().hasAll(['tempC', 'humidityPct', 'source', 'at']) &&
          request.resource.data.tempC is number &&
          request.resource.data.humidityPct is number &&
          request.resource.data.source is string &&
          request.resource.data.at is timestamp
        );
        allow update, delete: if isOwner();
      }
    }

    // Cold storage units within mandis (retained for backward compatibility)
    match /storageUnits/{unitId} {
      allow read: if true;
      allow create, update: if isApproved('mandi') || isOwner() || signedIn() || isDevice(unitId, 'storage');
      allow delete: if isOwner() || isApproved('mandi') || signedIn();

      // Telemetry readings subcollection (DHT22 temp & humidity)
      match /readings/{readingId} {
        allow read: if true;
        allow create: if isOwner() || isApproved('mandi') || (
          isDevice(unitId, 'storage') &&
          request.resource.data.keys().hasAll(['tempC', 'humidityPct', 'at']) &&
          request.resource.data.tempC is number &&
          request.resource.data.humidityPct is number &&
          request.resource.data.at is timestamp
        );
        allow update, delete: if isOwner();
      }
    }

    // Retail shops
    match /shops/{shopId} {
      allow read: if true;
      allow create: if isApproved('shop') || isOwner() || (signedIn() && request.resource.data.shopPersonUid == request.auth.uid);
      allow update: if isOwner() || isApproved('shop') || (signedIn() && (request.resource.data.shopPersonUid == request.auth.uid || resource.data.shopPersonUid == request.auth.uid));
      allow delete: if isOwner() || (signedIn() && resource.data.shopPersonUid == request.auth.uid);
    }

    // Produce bags: Public read for consumer QR tracing (/b/<bagId>)
    // Strict status lifecycle machine enforcement
    match /bags/{bagId} {
      allow read: if true;
      allow create: if isOwner() || (
        (isApproved('farmer') || signedIn()) &&
        request.resource.data.farmerUid == request.auth.uid &&
        request.resource.data.status == 'CREATED'
      );
      allow update: if isOwner() ||
        isValidBagRatingUpdate() ||
        isValidBagStatusTransition();
      allow delete: if isOwner();
    }

    // Append-only tamper-evident audit ledger (owner can purge during demo reset)
    match /events/{eventId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.byUid == request.auth.uid;
      allow update: if false;
      allow delete: if isOwner();
    }

    // Consumer purchases
    match /purchases/{purchaseId} {
      allow read: if signedIn() && (
        request.auth.uid == resource.data.consumerUid ||
        isOwner() ||
        isApproved('shop') ||
        (resource.data.shopId != null)
      );
      allow create: if isOwner() ||
        ((isApproved('consumer') || signedIn()) && request.resource.data.consumerUid == request.auth.uid) ||
        ((isApproved('shop') || signedIn()) && request.resource.data.paymentStatus == 'PAID_COUNTER');
      allow update, delete: if isOwner();
    }

    // Client-side crash and error telemetry (Crashlytics equivalent for Web)
    match /client_errors/{errorId} {
      // Allow anyone (signed-in or anonymous) to report a client error
      allow create: if request.resource.data.keys().hasAll(['message', 'fatal', 'timestamp'])
                   && request.resource.data.message is string
                   && request.resource.data.message.size() <= 5000;
      // Only system owner / admin can read, list, or delete crash reports
      allow read, delete: if isOwner();
      allow update: if false;
    }

    // Default deny all other requests
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
